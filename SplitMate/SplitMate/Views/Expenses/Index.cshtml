
@model IEnumerable<SplitMate.Models.Expense>

@{
    ViewData["Title"] = "Expense Management";

    var expenses = Model?.ToList()
        ?? new List<SplitMate.Models.Expense>();

    var totalAmount = expenses.Sum(e => e.Amount);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Expense Management</h1>
            <p class="text-muted">
                Manage and track your shared expenses.
            </p>
        </div>

        <a asp-controller="Expenses"
           asp-action="Create"
           class="btn btn-primary">
            + Add Expense
        </a>
    </div>

    <!-- Search and filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5>Search and Filter</h5>

            <form asp-controller="Expenses"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Search</label>
                        <input type="text"
                               name="searchTerm"
                               value="@Context.Request.Query["searchTerm"]"
                               class="form-control"
                               placeholder="Search expenses..." />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <input type="text"
                               name="category"
                               value="@Context.Request.Query["category"]"
                               class="form-control"
                               placeholder="e.g. Food, Travel" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Group</label>
                        <input type="text"
                               name="groupName"
                               value="@Context.Request.Query["groupName"]"
                               class="form-control"
                               placeholder="Group name" />
                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        Apply Filters
                    </button>

                    <a asp-controller="Expenses"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- Total expenses -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>Total Expenses</h5>

            <h2 class="text-primary">
                @totalAmount.ToString("F2")
            </h2>

            <p class="text-muted mb-0">
                Total for currently displayed expenses
            </p>
        </div>
    </div>

    <!-- Expenses table -->
    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Expense List</h5>

            @if (!expenses.Any())
            {
                <div class="alert alert-info">
                    No expenses found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Group</th>
                                <th>Paid By</th>
                                <th>Date</th>
                                <th>Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var expense in expenses)
                            {
                                <tr>
                                    <td>@expense.Title</td>
                                    <td>@expense.Category</td>
                                    <td>@expense.GroupName</td>
                                    <td>@expense.PaidBy</td>
                                    <td>
                                        @expense.ExpenseDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @expense.Amount.ToString("F2")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
