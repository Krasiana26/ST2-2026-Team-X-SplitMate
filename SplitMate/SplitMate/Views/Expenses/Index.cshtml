
@model IEnumerable<SplitMate.Models.Expense>

@{
    ViewData["Title"] = "Expense Management";

    var expenses = Model?.ToList()
        ?? new List<SplitMate.Models.Expense>();

    var totalAmount = expenses.Sum(e => e.Amount);
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Context.Request.Query["searchTerm"].ToString())
        || !string.IsNullOrWhiteSpace(Context.Request.Query["category"].ToString())
        || !string.IsNullOrWhiteSpace(Context.Request.Query["groupName"].ToString());
}

<div class="container mt-4 expense-page">
    <header class="expense-page-header">
        <div>
            <span class="expense-eyebrow">YOUR FINANCES</span>
            <h1>Expense Management</h1>
            <p class="text-muted mb-0">Manage and track your shared expenses.</p>
        </div>

        <a asp-controller="Expenses"
           asp-action="Create"
           class="btn btn-primary expense-add-button">
            <span aria-hidden="true">+</span>
            Add Expense
        </a>
    </header>

    <section class="card expense-summary" aria-label="Expense summary">
        <div class="card-body">
            <div>
                <span class="expense-summary-label">Total shown</span>
                <p class="expense-summary-caption">Based on current filters</p>
            </div>
            <div class="expense-summary-total">
                <span>@totalAmount.ToString("F2")</span>
                <span class="expense-summary-currency">EUR</span>
            </div>
            <div class="expense-summary-count">
                <span class="expense-summary-count-value">@expenses.Count</span>
                <span>@(expenses.Count == 1 ? "expense" : "expenses")</span>
            </div>
        </div>
    </section>

    <section class="card expense-filter-card" aria-labelledby="expense-filter-title">
        <div class="card-body">
            <div class="expense-section-heading">
                <div>
                    <h2 id="expense-filter-title">Search and filter</h2>
                    <p class="text-muted mb-0">Narrow the list by description, category, or group.</p>
                </div>
            </div>

            <form asp-controller="Expenses"
                  asp-action="Index"
                  method="get">
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="expense-search">Search</label>
                        <input id="expense-search"
                               type="text"
                               name="searchTerm"
                               value="@Context.Request.Query["searchTerm"]"
                               class="form-control"
                               placeholder="Search expenses..." />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="expense-category-filter">Category</label>
                        <input id="expense-category-filter"
                               type="text"
                               name="category"
                               value="@Context.Request.Query["category"]"
                               class="form-control"
                               placeholder="e.g. Food, Travel" />
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="expense-group-filter">Group</label>
                        <input id="expense-group-filter"
                               type="text"
                               name="groupName"
                               value="@Context.Request.Query["groupName"]"
                               class="form-control"
                               placeholder="Group name" />
                    </div>
                </div>

                <div class="expense-filter-actions">
                    <button type="submit" class="btn btn-primary">Apply filters</button>
                    <a asp-controller="Expenses"
                       asp-action="Index"
                       class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </section>

    <section class="card expense-list-card" aria-labelledby="expense-list-title">
        <div class="card-body">
            <div class="expense-section-heading expense-list-heading">
                <div>
                    <h2 id="expense-list-title">Expense list</h2>
                    <p class="text-muted mb-0">The expenses matching your current view.</p>
                </div>
                <span class="expense-list-count">@expenses.Count shown</span>
            </div>

            @if (!expenses.Any())
            {
                <div class="expense-empty-state" role="status">
                    <svg class="expense-empty-illustration" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
                        <rect x="19" y="17" width="58" height="66" rx="8" fill="#f3eadc" />
                        <path d="M34 37h28M34 49h18M34 61h11" fill="none" stroke="#8d704b" stroke-linecap="round" stroke-width="4" />
                        <circle cx="68" cy="67" r="13" fill="#fff" stroke="#d8b98b" stroke-width="4" />
                        <path d="M68 60v14M64 63h6a3 3 0 0 1 0 6h-5" fill="none" stroke="#8d704b" stroke-linecap="round" stroke-width="2.5" />
                    </svg>
                    <h3>@(hasActiveFilters ? "No matching expenses" : "No expenses yet")</h3>
                    <p class="text-muted">
                        @(hasActiveFilters
                            ? "Try adjusting your filters, or add an expense to your list."
                            : "Your shared spending will appear here once you add an expense.")
                    </p>
                    <div class="expense-empty-actions">
                        @if (hasActiveFilters)
                        {
                            <a asp-controller="Expenses" asp-action="Index" class="btn btn-outline-secondary">Clear filters</a>
                        }
                        <a asp-controller="Expenses" asp-action="Create" class="btn btn-primary">Add Expense</a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive expense-table-wrap">
                    <table class="table table-hover expense-table">
                        <thead>
                            <tr>
                                <th scope="col">Title</th>
                                <th scope="col">Category</th>
                                <th scope="col">Group</th>
                                <th scope="col">Paid by</th>
                                <th scope="col">Date</th>
                                <th scope="col" class="text-end">Amount</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in expenses)
                            {
                                var categoryKey = expense.Category?.Trim().ToLowerInvariant();
                                <tr>
                                    <td class="expense-title-cell">@expense.Title</td>
                                    <td>
                                        @switch (categoryKey)
                                        {
                                            case "food":
                                                <span class="expense-category expense-category-food">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M6 2v6m3-6v6M4 8h7M7.5 8v10M15 2v16m0-16c2 2 2 5 0 7" /></svg>
                                                    @expense.Category
                                                </span>
                                                break;
                                            case "travel":
                                                <span class="expense-category expense-category-travel">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m2 11 7 1 6-8c.7-.9 2.2-.2 1.8.9L13.5 13l3 2-1 1-4-1-3 3-1-.5 1-3-6-2z" /></svg>
                                                    @expense.Category
                                                </span>
                                                break;
                                            case "shopping":
                                                <span class="expense-category expense-category-shopping">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 7h12l1 11H3L4 7Zm3 0a3 3 0 0 1 6 0" /></svg>
                                                    @expense.Category
                                                </span>
                                                break;
                                            case "bills":
                                                <span class="expense-category expense-category-bills">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M5 2h10v16l-2.5-1.5L10 18l-2.5-1.5L5 18V2Zm3 5h4m-4 4h4" /></svg>
                                                    @expense.Category
                                                </span>
                                                break;
                                            default:
                                                <span class="expense-category expense-category-neutral">
                                                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7" /><path d="M10 9v5m0-8h.01" /></svg>
                                                    @expense.Category
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td>@expense.GroupName</td>
                                    <td>@expense.PaidBy</td>
                                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end expense-amount-cell">@expense.Amount.ToString("F2")</td>
                                    <td>
                                        <div class="expense-row-actions">
                                            <a asp-controller="Expenses"
                                               asp-action="Edit"
                                               asp-route-id="@expense.Id"
                                               class="btn btn-sm expense-action expense-action-edit"
                                               aria-label="Edit @expense.Title">Edit</a>
                                            <a asp-controller="Expenses"
                                               asp-action="Delete"
                                               asp-route-id="@expense.Id"
                                               class="btn btn-sm expense-action expense-action-delete"
                                               aria-label="Delete @expense.Title">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
