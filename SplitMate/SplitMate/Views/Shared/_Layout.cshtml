
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SplitMate</title>

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SplitMate.styles.css" asp-append-version="true" />
</head>

<body class="app-body">

    <div class="app-layout">

        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">S</span>
                <span>SplitMate</span>
            </a>

            <div class="sidebar-section">
                <span class="sidebar-label">MENU</span>

                                <a class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                                     aria-current="@(currentController == "Home" && currentAction == "Index" ? "page" : null)"
                                     asp-controller="Home" asp-action="Index">
                    <span class="menu-icon">⌂</span>
                    Dashboard
                </a>

                                <a class="sidebar-link @(currentController == "Expenses" ? "active" : "")"
                                     aria-current="@(currentController == "Expenses" ? "page" : null)"
                                     asp-controller="Expenses" asp-action="Index">
                    <span class="menu-icon">↗</span>
                    Expenses
                </a>

                                <a class="sidebar-link @(currentController == "Splitting" ? "active" : "")"
                                     aria-current="@(currentController == "Splitting" ? "page" : null)"
                                     asp-controller="Splitting" asp-action="Index">
                    <span class="menu-icon">⇄</span>
                    Split Expenses
                </a>

                                <a class="sidebar-link @(currentController == "AiAssistant" ? "active" : "")"
                                     aria-current="@(currentController == "AiAssistant" ? "page" : null)"
                                     asp-controller="AiAssistant" asp-action="Index">
                    <span class="menu-icon">✦</span>
                    AI Assistant
                </a>
            </div>

            <div class="sidebar-bottom">
                <div class="sidebar-divider"></div>

                                <a class="sidebar-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")"
                                     aria-current="@(currentController == "Home" && currentAction == "Privacy" ? "page" : null)"
                                     asp-controller="Home" asp-action="Privacy">
                    <span class="menu-icon">⚙</span>
                    Settings
                </a>

                <div class="sidebar-profile">
                    <div class="profile-avatar">SM</div>
                    <div>
                        <div class="profile-name">SplitMate</div>
                        <div class="profile-caption">Expense Manager</div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div>
                    <span class="topbar-caption">PERSONAL FINANCE</span>
                    <h6 class="topbar-title mb-0">Manage your expenses</h6>
                </div>

                <a asp-controller="Expenses"
                   asp-action="Create"
                   class="btn-add-expense">
                    + Add Expense
                </a>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>

            <footer class="app-footer">
                © 2026 SplitMate. Manage money together.
            </footer>
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
